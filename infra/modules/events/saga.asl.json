{
  "Comment": "Order saga: reserve stock, charge payment, confirm. If payment fails, release the stock. Every step is idempotent, so retries and duplicate executions are safe.",
  "StartAt": "ReserveStock",
  "States": {
    "ReserveStock": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${steps_function_arn}",
        "Payload": {
          "action": "reserve",
          "order_id.$": "$.detail.order_id"
        }
      },
      "ResultSelector": {
        "order_id.$": "$.Payload.order_id",
        "customer_id.$": "$.Payload.customer_id"
      },
      "ResultPath": "$.order",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 1,
          "MaxAttempts": 4,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        },
        {
          "ErrorEquals": ["StockContentionError"],
          "IntervalSeconds": 1,
          "MaxAttempts": 5,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["OutOfStockError"],
          "ResultPath": "$.error",
          "Next": "RejectOutOfStock"
        }
      ],
      "Next": "ChargePayment"
    },
    "ChargePayment": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${steps_function_arn}",
        "Payload": {
          "action": "charge",
          "order_id.$": "$.order.order_id"
        }
      },
      "ResultSelector": {
        "payment_id.$": "$.Payload.payment_id"
      },
      "ResultPath": "$.payment",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 1,
          "MaxAttempts": 4,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        },
        {
          "ErrorEquals": ["PaymentProviderUnavailableError"],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["PaymentDeclinedError"],
          "ResultPath": "$.error",
          "Next": "ReleaseStockDeclined"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ReleaseStockFailed"
        }
      ],
      "Next": "ConfirmOrder"
    },
    "ReleaseStockDeclined": {
      "Type": "Task",
      "Comment": "Compensation for a declined payment.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${steps_function_arn}",
        "Payload": {
          "action": "release",
          "reason": "PAYMENT_DECLINED",
          "order_id.$": "$.order.order_id"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 1,
          "MaxAttempts": 6,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "OrderRejected"
    },
    "ReleaseStockFailed": {
      "Type": "Task",
      "Comment": "Compensation when the payment step fails for any other reason.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${steps_function_arn}",
        "Payload": {
          "action": "release",
          "reason": "PAYMENT_FAILED",
          "order_id.$": "$.order.order_id"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 1,
          "MaxAttempts": 6,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "OrderRejected"
    },
    "RejectOutOfStock": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${steps_function_arn}",
        "Payload": {
          "action": "reject",
          "reason": "OUT_OF_STOCK",
          "order_id.$": "$.detail.order_id"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 1,
          "MaxAttempts": 6,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "OrderRejected"
    },
    "OrderRejected": {
      "Type": "Succeed",
      "Comment": "A rejected order is a business outcome, not a technical failure."
    },
    "ConfirmOrder": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${steps_function_arn}",
        "Payload": {
          "action": "confirm",
          "order_id.$": "$.order.order_id"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 1,
          "MaxAttempts": 6,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "PublishOrderConfirmed"
    },
    "PublishOrderConfirmed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "${event_bus_name}",
            "Source": "aedo.orders",
            "DetailType": "OrderConfirmed",
            "Detail": {
              "order_id.$": "$.order.order_id",
              "customer_id.$": "$.order.customer_id",
              "payment_id.$": "$.payment.payment_id"
            }
          }
        ]
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 1,
          "MaxAttempts": 6,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "End": true
    }
  }
}
